// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  // Appearance
  "theme": {
    "mode": "dark",
    "light": "Rosé Pine Dawn",
    "dark": "Catppuccin Mocha"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "ui_font_size": 16,
  "buffer_font_family": "Iosevka",
  "buffer_font_fallbacks": ["JetBrainsMono Nerd Font"],
  "buffer_font_size": 13.0,
  "buffer_font_features": { "NWID": true, "ss05": true },

  // Input
  "base_keymap": "JetBrains",
  "vim_mode": true,

  // Editor
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "always"
  },
  "cursor_animation": {
    "enabled": true
  },
  "semantic_tokens": "combined",
  "diff_view_style": "split",
  "format_on_save": "modifications",

  // Workspace
  "cli_default_open_behavior": "new_window",
  "session": {
    "trust_all_worktrees": true
  },
  "project_panel": {
    "dock": "left"
  },
  "preview_tabs": {
    "enable_preview_multibuffer_from_code_navigation": true
  },

  // Terminal
  "terminal": {
    "font_features": { "NWID": true, "ss05": true }
  },

  // Languages
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright", "todo-highlight-lsp"]
    }
  },

  // AI agents
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
      "default_config_options": {
        "mode": "agent-full-access",
        "fast-mode": true
      }
    },
    "cursor": {
      "type": "registry",
      "default_config_options": {
        "model": "grok-4.7",
        "mode": "agent",
        "effort": "xhigh",
        "context": "500k"
      }
    }
  },

  // Privacy
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  }
}
